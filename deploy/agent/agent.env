# systemd EnvironmentFile 语法；无需 export。修改后重启 openlb-agent。
OPENLB_SERVE_PORT=:38080
OPENLB_AGENT_METRICS_ADDRESS=:38082
OPENLB_AGENT_STATE_DIR=/var/lib/openlb-agent
OPENLB_SHUTDOWN_TIMEOUT=30s

# 使用主机上的 nginx；安装脚本按此目录备份并覆盖 nginx.conf。
OPENLB_NGINX_BIN=/usr/sbin/nginx
OPENLB_NGINX_HOME=/etc/nginx
OPENLB_NGINX_COMMAND_TIMEOUT=3s
OPENLB_NGINX_STATUS_URL=http://127.0.0.1:8888/nginx_status

# 安装 ipvsadm 后可承接 lvs class；VIP 默认自动发现本机内网 IPv4。
OPENLB_LVS_BIN=/usr/sbin/ipvsadm
OPENLB_LVS_FORWARDING=nat
OPENLB_LVS_SCHEDULER=rr
OPENLB_LVS_COMMAND_TIMEOUT=3s
# OPENLB_LVS_VIPS=10.0.0.10

OPENLB_ENABLE_L4_STATS=true
OPENLB_CONNECTION_STATS_INTERVAL=15
